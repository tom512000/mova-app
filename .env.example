# Copy this file to .env and fill in real values. Never commit the real .env.
# Used by docker-compose.yml to configure all services.

# --- PostgreSQL ---
POSTGRES_USER=letterboxd
POSTGRES_PASSWORD=changeme
POSTGRES_DB=letterboxd
POSTGRES_PORT=5432

# --- Backend (Symfony) ---
APP_ENV=dev
APP_SECRET=changeme-generate-a-random-32-char-string
BACKEND_PORT=8000

# --- TMDB API ---
# Get a free API key/token at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Letterboxd RSS sync (optional) ---
# Read ONCE, by the multi-user migration, to seed the owner account. After that the
# Letterboxd username and the sync toggle live on each user row -- editing these has no
# effect on an already-migrated database.
# Your public Letterboxd username, e.g. for https://letterboxd.com/johndoe/ it's "johndoe"
LETTERBOXD_USERNAME=
LETTERBOXD_RSS_SYNC_ENABLED=false

# --- Frontend (Vite) ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api

# --- Adminer (optional DB admin UI, `docker compose --profile dev up`) ---
ADMINER_PORT=8080

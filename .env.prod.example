# Copy to .env.prod, fill in real values, and keep it off the machine you edit code on.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- The address the site answers on ---
# A hostname gets a Let's Encrypt certificate automatically. `localhost` gets one from
# Caddy's own CA, which is how you try the production stack out on your machine. A bare
# `:80` stays on plain HTTP and cannot hold a login, because the prod session cookie is
# Secure — that value is only for a stack sitting behind another TLS proxy.
SITE_ADDRESS=mova.tomsikora.dev
# Expiry warnings from Let's Encrypt are opt-in and live in docker/frontend/Caddyfile:
# uncomment the `email` line there. Certificates renew whether or not one is set.

# --- PostgreSQL ---
POSTGRES_USER=mova
# Not a password you have used anywhere else, and not one you type. Generate it:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=mova

# --- Symfony ---
# Signs the session cookie among other things. Generate it, never reuse the dev value:
#   openssl rand -hex 32
APP_SECRET=

# --- TMDB ---
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Backups ---
# A host path, please, not the default named volume. A backup on the same disk as the
# database survives a bad migration and nothing else — not a dead disk, and not this machine
# disappearing. Point it somewhere that is itself synced off the box.
# The backup container runs as uid 70, so a host directory has to be given to it first:
#     sudo mkdir -p /var/backups/mova && sudo chown 70:70 /var/backups/mova
# Leave this unset to use a docker volume instead, which needs no such step.
BACKUP_PATH=/var/backups/mova
# Seconds between dumps, and how many to keep. 86400 x 14 is a fortnight of daily dumps.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14

# --- Only if the SPA and the API end up on different domains ---
# Leave this alone otherwise. The stack serves both from one origin, so CORS never applies,
# and the default denies every cross-origin caller. Escape the dots if you do set it: they
# are regex wildcards, and an unescaped one lets a lookalike hostname through.
# CORS_ALLOW_ORIGIN=^https://mova\.example\.com$

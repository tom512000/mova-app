# The production image: a static build behind Caddy. Separate from Dockerfile rather than a
# stage added to it, so `docker compose up` keeps starting the dev server exactly as before.
#
# VITE_API_BASE_URL is read at build time, not at run time — Vite inlines it into the bundle.
# The same image therefore cannot be pointed at a different API later; build one per target.

FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .

ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

FROM caddy:2-alpine

COPY docker/frontend/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

EXPOSE 80

# The production image: the built SPA plus the edge Caddy that also proxies the API.
# Separate from Dockerfile rather than a stage added to it, so `docker compose up` keeps
# starting the dev server exactly as before.
#
# VITE_API_BASE_URL is read at build time, not at run time — Vite inlines it into the bundle.
# It therefore defaults to the relative /api, which is what makes this image portable: the
# same build serves any hostname, because Caddy answers /api from the same origin. Only a
# deployment that splits the SPA from the API across two domains needs to pass an absolute
# URL here, and it would then need CORS and SameSite=None to go with it.

FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

FROM caddy:2-alpine

COPY docker/frontend/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

# 443 as well as 80: with a hostname in SITE_ADDRESS, Caddy provisions a certificate and
# redirects 80 to 443 on its own.
EXPOSE 80 443
